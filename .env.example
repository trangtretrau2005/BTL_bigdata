# ============================================================
# .env.example - Template biến môi trường
# Sao chép file này thành .env và điền giá trị phù hợp
# KHÔNG commit file .env lên git
# ============================================================

# --- HDFS ---
HDFS_BASE_PATH=/ai_docs
HDFS_NAMENODE_URL=hdfs://localhost:9000

# --- Qdrant Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ai_documents_verified_v2

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M

# --- Retrieval ---
TOP_K=5

# --- Chunking ---
CHUNK_SIZE=2200
CHUNK_OVERLAP=240
EMBED_BATCH_SIZE=8

# --- Timeouts ---
REQUEST_TIMEOUT=300

# --- Pipeline ---
PIPELINE_VERSION=1.0.0

# WebHDFS (Docker overrides the internal host)
HDFS_WEB_URL=http://localhost:9870
