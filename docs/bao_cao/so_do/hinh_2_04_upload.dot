digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.30", ranksep="0.45", splines=polyline, fontname="Liberation Serif", fontsize=20, label="Tiếp nhận và lập chỉ mục tệp người dùng", labelloc=t];
node [shape=box, style="rounded,filled", fillcolor="#F2F6F8", color="#31576B", fontcolor="#142C3A", fontname="Liberation Serif", fontsize=13, margin="0.16,0.11"];
edge [color="#56717F", arrowsize=0.7, fontname="Liberation Serif", fontsize=11, fontcolor="#4B5962"];
s [label="Chọn tệp trên giao diện", shape="ellipse", fillcolor="#193E51", fontcolor="white"];
click [label="Chọn khu vực / ngôn ngữ\nBấm Cập nhật dữ liệu"];
valid [label="Loại, chữ ký, kích thước hợp lệ?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
bad [label="Hiển thị lỗi; không lưu lô lỗi định dạng", fillcolor="#FBEDE9", color="#AB6453"];
hash [label="SHA-256 nội dung tệp\nID upload_<hash>"];
exists [label="Đã lưu cùng checksum?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
reuse [label="Giữ ID và tên đã lưu\nSửa bản gốc nếu hỏng/mất"];
raw [label="Lưu tệp gốc + catalog\nprovenance=user_upload", shape="cylinder", fillcolor="#E6EFE9", color="#3B7565"];
parse [label="Parser PDF / DOCX / TXT / HTML / XML"];
text [label="Có văn bản đủ dài?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
scan [label="Báo scan/không đọc được\nKhông đưa nội dung rỗng vào ETL", fillcolor="#FBEDE9", color="#AB6453"];
parsed [label="Parsed JSON + tên tệp gốc\nHiệu lực unknown", shape="cylinder", fillcolor="#E6EFE9", color="#3B7565"];
pipeline [label="Ghép corpus → Spark → chia đoạn\nEmbedding → snapshot mới"];
dup [label="Nội dung bị Spark khử trùng?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
known [label="Nội dung đã có trong thư viện\nGắn duplicate_of"];
indexed [label="Đánh dấu đã lập chỉ mục\nCó thể chọn để hỏi đáp"];
lake [label="Đồng bộ Raw/Parsed và phiên bản\nSilver/Chunks lên HDFS"];
source [label="Dẫn chứng giữ original_filename\nNút Tải tệp gốc"];
e [label="Kết thúc", shape="ellipse", fillcolor="#193E51", fontcolor="white"];
s -> click;
click -> valid;
valid -> bad [label="không"];
valid -> hash [label="có"];
hash -> exists;
exists -> reuse [label="có"];
exists -> raw [label="chưa"];
reuse -> parse;
raw -> parse;
parse -> text;
text -> scan [label="không"];
text -> parsed [label="có"];
parsed -> pipeline;
pipeline -> dup;
dup -> known [label="có"];
dup -> indexed [label="không"];
known -> lake;
indexed -> lake;
lake -> source;
source -> e;
bad -> e;
scan -> e;
}