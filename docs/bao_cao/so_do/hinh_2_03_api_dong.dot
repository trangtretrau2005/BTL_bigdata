digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.30", ranksep="0.45", splines=polyline, fontname="Liberation Serif", fontsize=20, label="Thu thập tăng dần qua API Bộ Tư pháp", labelloc=t];
node [shape=box, style="rounded,filled", fillcolor="#F2F6F8", color="#31576B", fontcolor="#142C3A", fontname="Liberation Serif", fontsize=13, margin="0.16,0.11"];
edge [color="#56717F", arrowsize=0.7, fontname="Liberation Serif", fontsize=11, fontcolor="#4B5962"];
s [label="Bắt đầu nguồn API", shape="ellipse", fillcolor="#193E51", fontcolor="white"];
cfg [label="Đọc cấu hình nguồn\nTừ khóa + số trang + giới hạn"];
cp [label="Đã có checkpoint hoàn tất?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
first [label="Cửa sổ ban đầu 730 ngày"];
next [label="Từ checkpoint trừ 7 ngày"];
list [label="POST /doc/all\nPhân trang, issueDate giảm dần"];
ok [label="Cấu trúc danh mục hợp lệ?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
raw [label="Lưu JSON catalog theo SHA-256", shape="cylinder", fillcolor="#E6EFE9", color="#3B7565"];
filter [label="Lọc ngày / chủ đề AI\nKhông nhận ngày tương lai"];
known [label="Metadata đã kiểm tra hôm nay?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
skip [label="Bỏ qua toàn văn không đổi"];
limit [label="Đạt giới hạn thay đổi?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
backlog [label="Ghi còn dữ liệu chờ lượt sau"];
detail [label="GET /doc/{id}\ndocumentContent.content"];
body [label="Toàn văn thật, đủ dài?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
reject [label="Ghi lỗi / loại trang chặn\nKhông dùng abstract hay aiResults", fillcolor="#FBEDE9", color="#AB6453"];
canon [label="Ghép số hiệu + cơ quan + năm\nTái sử dụng ID văn bản đã có"];
hash [label="Hash nội dung + lưu Raw/Parsed\nCập nhật catalog và trạng thái"];
more [label="Còn trang trong cửa sổ?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
done [label="Nguồn không lỗi / không backlog?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
write [label="Nâng checkpoint hoàn tất"];
keep [label="Giữ checkpoint trước\nLượt sau kiểm tra lại phần thiếu"];
e [label="Trả báo cáo cho worker", shape="ellipse", fillcolor="#193E51", fontcolor="white"];
s -> cfg;
cfg -> cp;
cp -> first [label="chưa"];
cp -> next [label="có"];
first -> list;
next -> list;
list -> ok;
ok -> reject [label="không"];
ok -> raw [label="có"];
raw -> filter;
filter -> known;
known -> skip [label="có"];
known -> limit [label="chưa"];
limit -> backlog [label="có"];
limit -> detail [label="chưa"];
detail -> body;
body -> reject [label="không"];
body -> canon [label="có"];
canon -> hash;
hash -> more;
skip -> more;
backlog -> more;
reject -> more;
more -> list [label="có"];
more -> done [label="không"];
done -> write [label="có"];
done -> keep [label="không"];
write -> e;
keep -> e;
}