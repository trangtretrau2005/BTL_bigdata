digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.30", ranksep="0.45", splines=polyline, fontname="Liberation Serif", fontsize=20, label="Thiết kế trợ lý giọng nói và người thuyết trình", labelloc=t];
node [shape=box, style="rounded,filled", fillcolor="#F2F6F8", color="#31576B", fontcolor="#142C3A", fontname="Liberation Serif", fontsize=13, margin="0.16,0.11"];
edge [color="#56717F", arrowsize=0.7, fontname="Liberation Serif", fontsize=11, fontcolor="#4B5962"];
q [label="Câu hỏi bằng văn bản\nhoặc thu âm WAV tùy chọn"];
asr [label="Nếu thu âm: nhận dạng vi-VN\nNgười dùng đọc lại / chỉnh câu hỏi"];
rag [label="RAG → câu trả lời có nguồn\nHiển thị ngay phần văn bản"];
click [label="Người dùng bấm tạo giọng?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
clean [label="Bỏ Markdown / nhãn [Sx] / URL\nMở rộng AI, LLM, số hiệu phổ biến"];
key [label="Khóa nội dung + voice + rate\nCache 600 giây / tối đa 12 mục UI"];
neural [label="Ưu tiên Hoài My trực tuyến\nChia cụm tối đa 700 ký tự"];
ok [label="Có âm thanh?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
fallback [label="Piper dự phòng 240 ký tự/cụm\nSau đó Google 170 nếu cần"];
result [label="Có playlist âm thanh?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
device [label="Thử giọng Việt trên thiết bị\nKhông có thì báo rõ"];
bundle [label="Playlist: text + audio_b64 + MIME\nProvider thật + playback_rate", shape="cylinder", fillcolor="#E6EFE9", color="#3B7565"];
player [label="Iframe HTML/JS + SVG nữ\nPhát / tạm dừng / đọc lại / tốc độ"];
audio [label="Audio từng đoạn → Web Audio\nAnalyserNode, fftSize=256"];
rms [label="RMS mẫu thời gian → năng lượng\nCập nhật miệng và sóng âm"];
subtitle [label="Sự kiện ended → đoạn tiếp theo\nĐổi phụ đề theo đoạn âm thanh"];
done [label="Đã đọc xong / dừng\nHủy hoạt ảnh và audio khi rời trang", shape="ellipse", fillcolor="#193E51", fontcolor="white"];
q -> asr [label="thu âm"];
q -> rag [label="nhập chữ"];
asr -> rag;
rag -> click;
click -> done [label="không"];
click -> clean [label="có"];
clean -> key;
key -> neural [label="chưa có cache"];
key -> bundle [label="cache đúng khóa"];
neural -> ok;
ok -> bundle [label="có"];
ok -> fallback [label="không"];
fallback -> result;
result -> bundle [label="có"];
result -> device [label="không"];
bundle -> player;
device -> player [label="nếu có giọng Việt"];
player -> audio;
audio -> rms;
audio -> subtitle;
rms -> done;
subtitle -> done;
}