digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.30", ranksep="0.45", splines=polyline, fontname="Liberation Serif", fontsize=20, label="Luồng hỏi đáp có kiểm tra nguồn", labelloc=t];
node [shape=box, style="rounded,filled", fillcolor="#F2F6F8", color="#31576B", fontcolor="#142C3A", fontname="Liberation Serif", fontsize=13, margin="0.16,0.11"];
edge [color="#56717F", arrowsize=0.7, fontname="Liberation Serif", fontsize=11, fontcolor="#4B5962"];
s [label="Câu hỏi + region/document filter", shape="ellipse", fillcolor="#193E51", fontcolor="white"];
scope [label="Đúng phạm vi hoặc đã chọn tài liệu?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
no [label="Thiếu căn cứ / ngoài phạm vi"];
emb [label="BGE-M3 embedding câu hỏi"];
search [label="Qdrant cosine search\nTop-k, điều kiện payload"];
article [label="Nếu hỏi phạm vi/hành vi cấm:\nđọc đúng điều trong Silver đang dùng"];
score [label="Có nguồn có text + URL và score ≥ ngưỡng?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
cur [label="Có bản biên tập khớp ID và hash toàn điều?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
editor [label="Trả curated_summary\nmodel=null, nhãn biên tập rõ ràng"];
prompt [label="Prompt tiếng Việt + các nguồn [S1..Sk]\nNội dung tài liệu không phải chỉ thị"];
llm [label="Qwen3 4B Instruct\nnum_ctx=6144, num_predict=640"];
ref [label="LLM báo không đủ bằng chứng?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
cite [label="Nhãn nguồn hợp lệ và đủ trích dẫn?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
retry [label="Tạo lại tối đa một lần\nNếu vẫn lỗi: báo lỗi dịch vụ/đầu ra"];
ans [label="Hiển thị trả lời + trích đoạn + vị trí\nURL hoặc tải tệp gốc"];
tts [label="Tùy chọn nghe câu trả lời\nMột cấu hình giọng nữ"];
e [label="Kết thúc", shape="ellipse", fillcolor="#193E51", fontcolor="white"];
s -> scope;
scope -> no [label="không"];
scope -> emb [label="có"];
emb -> search;
search -> article;
article -> score;
score -> no [label="không"];
score -> cur [label="có"];
cur -> editor [label="có"];
cur -> prompt [label="không"];
prompt -> llm;
llm -> ref;
ref -> no [label="có"];
ref -> cite [label="không"];
cite -> retry [label="không"];
cite -> ans [label="có"];
editor -> ans;
ans -> tts;
tts -> e;
no -> e;
retry -> e;
}