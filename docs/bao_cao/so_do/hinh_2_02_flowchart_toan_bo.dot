digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.30", ranksep="0.45", splines=polyline, fontname="Liberation Serif", fontsize=20, label="Flowchart tổng thể vòng đời dữ liệu và phục vụ tra cứu", labelloc=t];
node [shape=box, style="rounded,filled", fillcolor="#F2F6F8", color="#31576B", fontcolor="#142C3A", fontname="Liberation Serif", fontsize=13, margin="0.16,0.11"];
edge [color="#56717F", arrowsize=0.7, fontname="Liberation Serif", fontsize=11, fontcolor="#4B5962"];
start [label="Mở ứng dụng", shape="ellipse", fillcolor="#193E51", fontcolor="white"];
choice [label="Thao tác của người dùng?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
upd [label="Bấm Cập nhật dữ liệu"];
lock [label="Có lượt khác đang chạy?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
busy [label="Theo dõi lượt hiện tại"];
save [label="Kiểm tra và lưu tệp được chọn\nHash + metadata nguồn người dùng"];
parse [label="Trích xuất tệp hợp lệ\nTách lỗi theo từng tệp"];
api [label="Bật lấy dữ liệu API?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
fetch [label="Danh mục phân trang mới nhất\nCheckpoint + khoảng chồng 7 ngày"];
full [label="Lọc chủ đề/ngày + lấy toàn văn\nLưu JSON bất biến + phiên bản"];
merge [label="Ghép corpus đã xác minh\nAPI + tệp người dùng hợp lệ"];
change [label="Chữ ký corpus thay đổi?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
same [label="Không lập chỉ mục lại\nTrả no_changes / partial"];
etl [label="Spark ETL → Parquet Silver\nChuẩn hóa + chất lượng + khử trùng"];
chunks [label="Chia đoạn theo điều/đoạn/câu\nGiữ nguồn + vị trí + phiên bản"];
embed [label="Tái sử dụng vector không đổi\nEmbedding các đoạn còn thiếu"];
snap [label="Snapshot Qdrant mới", shape="cylinder", fillcolor="#E6EFE9", color="#3B7565"];
check [label="Đủ point dự kiến?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
old [label="Giữ alias và manifest cũ\nGhi lỗi / cho chạy lại", fillcolor="#FBEDE9", color="#AB6453"];
publish [label="Đổi alias nguyên tử\nGhi manifest phiên bản đang dùng"];
lake [label="Đồng bộ các lớp lên HDFS\nĐối chiếu kích thước tệp"];
refresh [label="Cập nhật số đếm / trạng thái\nSẵn sàng tìm tài liệu mới"];
query [label="Nhận câu hỏi + bộ lọc\nKiểm tra phạm vi"];
retrieve [label="BGE-M3 → tìm Qdrant\nTop-k + mở rộng điều phù hợp"];
enough [label="Có bằng chứng đủ điểm?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
refuse [label="Thông báo thiếu căn cứ"];
generate [label="LLM hoặc bản biên tập có hash\nPhân biệt rõ chế độ trả lời"];
valid [label="Nhãn trích dẫn hợp lệ?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
retry [label="Thử sửa đầu ra tối đa một lần\nLỗi thì báo chưa thể trả lời"];
answer [label="Hiển thị câu trả lời / đoạn nguồn\nLiên kết hoặc tải tệp gốc"];
mode [label="Chế độ hiện tại?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
search [label="Hiển thị các đoạn tìm thấy\nKhông gọi LLM"];
library [label="Đọc catalog / manifest\nLọc, phân trang và mở nguồn"];
read [label="Người dùng yêu cầu nghe?", shape="diamond", style="filled", fillcolor="#FFF5DA"];
tts [label="Chuẩn hóa văn bản → TTS\nPlaylist / nhãn provider thực tế"];
voice [label="Người thuyết trình nữ\nPhụ đề + miệng theo biên độ + phát"];
qend [label="Kết thúc tra cứu", shape="ellipse", fillcolor="#193E51", fontcolor="white"];
lend [label="Kết thúc xem danh mục", shape="ellipse", fillcolor="#193E51", fontcolor="white"];
end [label="Kết thúc cập nhật", shape="ellipse", fillcolor="#193E51", fontcolor="white"];
start -> choice;
choice -> upd [label="cập nhật"];
choice -> query [label="hỏi / tìm"];
choice -> library [label="thư viện"];
library -> lend;
upd -> lock;
lock -> busy [label="có"];
busy -> end;
lock -> save [label="không"];
save -> parse;
parse -> api;
api -> fetch [label="có"];
fetch -> full;
full -> merge;
api -> merge [label="không"];
merge -> change;
change -> same [label="không"];
same -> refresh;
change -> etl [label="có"];
etl -> chunks;
chunks -> embed;
embed -> snap;
snap -> check;
check -> old [label="không / lỗi"];
check -> publish [label="có"];
old -> end;
publish -> lake;
lake -> refresh;
refresh -> end;
query -> retrieve;
retrieve -> mode;
mode -> search [label="tìm kiếm"];
mode -> enough [label="hỏi đáp"];
search -> qend;
enough -> refuse [label="không"];
enough -> generate [label="có"];
generate -> valid;
valid -> retry [label="không"];
retry -> qend;
valid -> answer [label="có"];
refuse -> qend;
answer -> read;
read -> qend [label="không"];
read -> tts [label="có"];
tts -> voice;
voice -> qend;
}